# Verity Global Environment Configuration Example

# -------------------------------------------------------------
# Backend API Configuration (/api)
# -------------------------------------------------------------
# Database: Neon / Supabase PostgreSQL (or local SQLite for dev)
DATABASE_URL=sqlite:///./verity.db
# Production Example: postgresql://verity_user:password@ep-cool-lake.us-east-2.aws.neon.tech/verity?sslmode=require

# Authentication & JWT
JWT_SECRET=super-secret-jwt-signing-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq AI Configuration (Ultra Fast LLM Inference)
# Sign up at https://console.groq.com to get your API key
# Leave empty for offline graceful degradation mode
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Daily Global AI Request Cap (Enforces hard budget and prevents runaway costs)
AI_DAILY_CAP=150

# CORS Allowed Origins (Comma-separated for multiple frontend domains)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://verity.vercel.app

# -------------------------------------------------------------
# Frontend Configuration (/web)
# -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Production Example: https://verity-api.onrender.com
