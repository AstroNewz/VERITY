# Verity Backend API Environment Configuration Example

# Database Connection (Neon / Supabase PostgreSQL for Production)
DATABASE_URL=sqlite:///./verity.db
# DATABASE_URL=postgresql://user:password@ep-verity.us-east-2.aws.neon.tech/verity?sslmode=require

# Authentication & Security
JWT_SECRET=verity-brand-governance-ultra-secret-jwt-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Claude AI Governance Engine
# If left unset, engine automatically operates in offline deterministic mode
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Rate Limiting & Daily Quota Caps
AI_DAILY_CAP=150

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://verity.vercel.app
